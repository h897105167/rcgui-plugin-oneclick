{
  "id": "onerclone",
  "name": { "zh": "一键 rclone", "en": "One-click rclone" },
  "version": "0.3.3",
  "entry": "main.wasm",
  "description": {
    "zh": "搜索 / 检测 / 安装 / 启动本机 rclone（rcd），并按启动参数自动连接",
    "en": "Search / check / install / start the local rclone (rcd) and connect automatically from the launch arguments"
  },
  "author": { "zh": "内置", "en": "Built-in" },
  "tags": {
    "zh": ["rclone", "进程", "安装", "下载", "rcd", "搜索"],
    "en": ["rclone", "process", "install", "download", "rcd", "search"]
  },
  "capabilities": ["kv", "fs", "http", "proc", "net", "env"],
  "platform": "windows",
  "builtin": true,
  "plugin_setting": {
    "version": 2,
    "summary": {
      "zh": "搜索 / 检测 / 安装 / 启动本机 rclone",
      "en": "Search / check / install / start the local rclone"
    },
    "on_start": "auto_start",
    "on_exit": "stop_on_exit",
    "controls": [
      {
        "kind": "status",
        "key": "conn",
        "label": { "zh": "运行状态", "en": "Run state" },
        "lamp": true
      },
      { "kind": "group", "key": "g_exe", "label": { "zh": "① rclone 程序", "en": "① rclone binary" } },
      {
        "kind": "field",
        "key": "exe",
        "label": { "zh": "程序路径", "en": "Program path" },
        "field": "path",
        "placeholder": {
          "zh": "选择 rclone.exe，或点「搜索本机」自动查找",
          "en": "Choose rclone.exe, or click “Search this PC”"
        },
        "dialog_title": { "zh": "选择 rclone.exe", "en": "Choose rclone.exe" },
        "filters": ["exe"]
      },
      {
        "kind": "action",
        "key": "pick_exe",
        "label": { "zh": "浏览…", "en": "Browse…" },
        "line": "exe-actions"
      },
      {
        "kind": "action",
        "key": "search_exe",
        "label": { "zh": "搜索本机", "en": "Search this PC" },
        "line": "exe-actions"
      },
      {
        "kind": "action",
        "key": "search_deep",
        "label": { "zh": "深度扫描", "en": "Deep scan" },
        "line": "exe-actions"
      },
      {
        "kind": "action",
        "key": "revalidate",
        "label": { "zh": "重新校验", "en": "Re-check" },
        "line": "exe-actions"
      },
      {
        "kind": "hint",
        "key": "exe_history_hint",
        "text": {
          "zh": "程序路径右侧的 ▾ 是历史记录：通过校验的路径会自动记入（最多 10 条）。",
          "en": "The ▾ next to the program path is the history: verified paths are recorded automatically (up to 10)."
        }
      },
      {
        "kind": "checks",
        "key": "checks",
        "text": {
          "zh": "尚未校验：点「重新校验」确认这个文件确实是 rclone（启动 / 自动启动时也会自动校验一次）",
          "en": "Not checked yet: click “Re-check” to confirm this file really is rclone (starting and auto-start check it once too)"
        }
      },

      { "kind": "group", "key": "g_install", "label": { "zh": "② 一键安装", "en": "② One-click install" } },
      {
        "kind": "field",
        "key": "edition",
        "label": { "zh": "版本", "en": "Edition" },
        "field": "select",
        "options": [
          { "value": "官方版", "label": { "zh": "官方版", "en": "Official" } },
          { "value": "增强版", "label": { "zh": "增强版", "en": "Enhanced" } }
        ],
        "default": "官方版"
      },
      {
        "kind": "field",
        "key": "source",
        "label": { "zh": "下载源", "en": "Download source" },
        "field": "select",
        "options": [
          { "value": "官方源", "label": { "zh": "官方源", "en": "Official" } },
          { "value": "镜像优先", "label": { "zh": "镜像优先", "en": "Mirrors first" } }
        ],
        "default": "官方源"
      },
      {
        "kind": "hint",
        "key": "install_edition_hint",
        "text": {
          "zh": "增强版（teldrive 后端）只发布在 GitHub Releases，镜像源对它不可用。",
          "en": "The enhanced build (teldrive backend) is published only on GitHub Releases; mirrors do not carry it."
        }
      },
      {
        "kind": "action",
        "key": "install",
        "label": { "zh": "一键下载并安装", "en": "Download and install" },
        "style": "primary"
      },
      { "kind": "progress", "key": "progress" },
      { "kind": "hint", "key": "install_hint", "text": "" },

      { "kind": "group", "key": "g_args", "label": { "zh": "③ 启动参数", "en": "③ Launch arguments" } },
      {
        "kind": "field",
        "key": "rc_user",
        "label": { "zh": "用户名", "en": "User name" },
        "field": "text",
        "default": "gui"
      },
      {
        "kind": "field",
        "key": "rc_pass",
        "label": { "zh": "密码", "en": "Password" },
        "field": "password",
        "placeholder": {
          "zh": "可留空：只要用户名非空，rclone 就会启用鉴权（空密码按 Basic 用户:空密码 校验）",
          "en": "May be empty: rclone enables auth as soon as the user name is set (an empty password means Basic user:empty)"
        }
      },
      { "kind": "field", "key": "port", "label": { "zh": "端口", "en": "Port" }, "field": "number", "default": "5572" },
      {
        "kind": "field",
        "key": "no_auth",
        "label": { "zh": "本地不校验", "en": "No auth locally" },
        "field": "bool",
        "default": "false"
      },
      {
        "kind": "field",
        "key": "silent",
        "label": { "zh": "静默启动", "en": "Start silently" },
        "field": "bool",
        "default": "true"
      },
      {
        "kind": "field",
        "key": "auto_connect",
        "label": { "zh": "自动连接", "en": "Connect automatically" },
        "field": "bool",
        "default": "true"
      },
      { "kind": "hint", "key": "auth_warning", "text": "" },

      { "kind": "group", "key": "g_boot", "label": { "zh": "④ 启动策略", "en": "④ Start policy" } },
      {
        "kind": "field",
        "key": "auto_start",
        "label": { "zh": "随程序自动启动", "en": "Start with the app" },
        "field": "bool",
        "default": "false"
      },
      {
        "kind": "field",
        "key": "stop_on_exit",
        "label": { "zh": "退出时停止 rclone", "en": "Stop rclone on exit" },
        "field": "bool",
        "default": "true"
      },
      { "kind": "hint", "key": "auto_start_hint", "text": "" },

      { "kind": "divider", "key": "d_run" },
      {
        "kind": "action",
        "key": "start",
        "label": { "zh": "启动 rclone", "en": "Start rclone" },
        "style": "primary",
        "line": "run-actions"
      },
      {
        "kind": "action",
        "key": "stop",
        "label": { "zh": "停止", "en": "Stop" },
        "style": "danger",
        "line": "run-actions"
      }
    ]
  }
}
